# Public build-time values only. Never put a secret in this file or in .env.
# Both of these are public by design and end up in the browser bundle.
VITE_GATEWAY_URL=
VITE_TURNSTILE_SITE_KEY=

# Worker secrets are NOT set here. They are set with `wrangler secret put`.
# See docs/self-hosting.md. Listed for reference only:
#   MODEL_API_KEY
#   TTS_API_KEY
#   STT_API_KEY
#   TURNSTILE_SECRET
#   SESSION_SECRET
