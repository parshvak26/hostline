{
  "name": "hostline",
  "version": "0.1.0",
  "private": true,
  "description": "Talk to an AI restaurant receptionist and book a table — in your browser, in one click.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p worker/tsconfig.json",
    "lint": "eslint . && npm run lint:css && npm run lint:design",
    "lint:css": "stylelint \"src/**/*.css\"",
    "lint:design": "node scripts/check-design-rules.mjs",
    "lint:phrases": "node scripts/check-phrase-coverage.mjs",
    "test": "vitest run",
    "test:unit": "vitest run --coverage",
    "test:worker": "vitest run --config worker/vitest.config.ts",
    "test:e2e": "playwright test",
    "converse": "tsx scripts/converse.ts",
    "seed": "tsx scripts/seed-diary.ts",
    "bake-audio": "tsx scripts/bake-audio.ts",
    "measure-latency": "tsx scripts/measure-latency.ts",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitest/coverage-v8": "2.1.8",
    "eslint": "9.17.0",
    "globals": "^17.11.0",
    "jsdom": "25.0.1",
    "stylelint": "16.12.0",
    "stylelint-config-standard": "36.0.1",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "vite": "6.0.7",
    "vitest": "2.1.8"
  }
}
